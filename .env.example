# Copy to .env (git-ignored). Read by docker compose (env_file: every variable reaches the
# container) and by local runs (uvicorn, make demo, demo.cmd, python -m app.summarize.*);
# variables already set in the shell win. Only variable *names* are ever stored in the DB.

# --- LLM ---------------------------------------------------------------------------------
# Cloud OpenAI-compatible provider (market-monitor example profile).
OPENAI_API_KEY=
# llama-server (or any OpenAI-compatible endpoint), e.g. http://<host>:8080/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# --- App ---------------------------------------------------------------------------------
# DISCOVER_CONFIG_PATH=/app/config/profiles.yaml
# DISCOVER_LOG_LEVEL=info
# Appended to the fetch User-Agent; SEC feeds expect a contact.
# DISCOVER_CONTACT_EMAIL=you@example.com
# Consecutive fetch failures before a source is disabled (shown with a re-enable button).
# DISCOVER_SOURCE_AUTO_DISABLE_FAILURES=10

# --- Auth (off when unset; set both before exposing the port) ------------------------------
# Admin key for Settings, every write and /api/admin/* (log in at /login).
DISCOVER_ADMIN_KEY=
# Comma-separated read keys for /api/v1 (Authorization: Bearer <key> or X-API-Key).
DISCOVER_API_KEYS=

# --- Alerts ------------------------------------------------------------------------------
# IANA zone for quiet hours and notification times, e.g. Europe/Berlin.
DISCOVER_TIMEZONE=UTC
# Base URL used for story links in notifications, e.g. http://nas.local:8000
DISCOVER_PUBLIC_URL=http://localhost:8000
# ntfy server and topic (https://ntfy.sh or self-hosted); token only for protected topics.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Webhook target and the HMAC-SHA256 key for the X-Discover-Signature header.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# SMTP for email alerts (port/TLS are set on the channel).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- API sources (referenced from sources as api_key: ${NAME}) -----------------------------
# Guardian Open Platform key: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# NewsData.io key: https://newsdata.io/register
NEWSDATA_API_KEY=
# X API bearer token (X sources are off by default and need monthly_budget_usd).
X_BEARER_TOKEN=
